# Gateway Configuration
APP_ENV=dev
DATABASE_URL=postgresql+asyncpg://maskgate:maskgate@localhost:5432/maskgate
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=change-me
DEMO_MODE=false
LOG_RAW_PAYLOADS=false

# Providers (leave empty to use mock only)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MOCK_PROVIDER_URL=http://localhost:9000

# Behavior
REQUEST_TIMEOUT_SECONDS=60
PROVIDER_ATTEMPT_TIMEOUT_SECONDS=20
MAX_RETRIES=2
MAX_PROMPT_CHARS=200000

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
